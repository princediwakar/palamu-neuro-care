{
  "name": "palamu-neuro-care",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 Edge versions"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "postinstall": "cp scripts/pre-commit.sh .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "prebuild": "node scripts/generate-content-dates.mjs",
    "build": "SERWIST_SUPPRESS_TURBOPACK_WARNING=1 next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "seo:analyze": "tsx scripts/seo/generate-tasks.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.2",
    "@serwist/next": "^9.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.511.0",
    "next": "^16.0.7",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-intersection-observer": "^9.16.0",
    "react-masonry-css": "^1.0.16",
    "serwist": "^9.5.11",
    "sharp": "^0.34.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.0.7",
    "openai": "^6.41.0",
    "tailwindcss": "^4.1.7",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5"
  }
}
